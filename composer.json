{
  "name": "jurono/sdk-php",
  "description": "Official PHP SDK for the Jurono legal services API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.9",
    "psr/http-message": "^2.0"
  },
  "autoload": {"psr-4": {"Jurono\\Sdk\\": "src/"}},
  "scripts": {
    "test": ["php tests/run.php", "php tests/http.php"],
    "lint": "php scripts/lint.php",
    "typecheck": "phpstan analyse --configuration=phpstan.neon --no-progress",
    "generate": "python3 scripts/generate.py",
    "check-generated": "python3 scripts/generate.py --check"
  },
  "config": {"sort-packages": true, "platform": {"php": "8.2.0"}},
  "authors": [{"name": "Jurono", "homepage": "https://jurono.eu"}],
  "support": {"issues": "https://github.com/jurono/jurono-sdk-php/issues"},
  "homepage": "https://github.com/jurono/jurono-sdk-php",
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  }
}
